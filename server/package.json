{
  "name": "@ibutest/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IbuTest API server",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./embedded": "./src/embedded.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts",
    "create-admin": "tsx --env-file-if-exists=../.env src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@electric-sql/pglite": "0.5.13",
    "@ibutest/shared": "1.0.0",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "multer": "2.5.0",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
