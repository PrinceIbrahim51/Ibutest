{
  "name": "@ibutest/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IbuTest desktop application (Electron)",
  "author": "IbuTest",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
