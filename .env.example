# =============================================================================
# IbuTest configuration. Copy to .env (never commit .env) or run:
#   npm run setup:env        # generates .env with strong random secrets
# Every value is validated at start-up; insecure production settings abort boot.
# =============================================================================

NODE_ENV=development
# Bind to loopback by default. Use 0.0.0.0 only behind a reverse proxy / in Docker.
HOST=127.0.0.1
PORT=4000
# Public HTTPS URL of the deployment (enables HSTS, upgrade-insecure-requests and CORS for itself).
# PUBLIC_URL=https://ibutest.example.com
# Extra allowed browser origins, comma separated (e.g. the Vite dev server or mobile app origins).
CORS_ORIGINS=http://localhost:5173
# Set when running behind a reverse proxy, e.g. "loopback", "1" or a subnet. Leave false otherwise.
TRUST_PROXY=false

# --- Database ---------------------------------------------------------------
# pglite = embedded PostgreSQL (zero setup, single node). postgres = external PostgreSQL server.
DB_DRIVER=pglite
PGLITE_DATA_DIR=./data/pglite
# DATABASE_URL=postgres://ibutest:REPLACE_ME@localhost:5432/ibutest
# disable | require | verify-full  (use verify-full for databases reached over a network)
DATABASE_SSL=disable
# DATABASE_SSL_CA_FILE=/run/secrets/db-ca.pem
UPLOAD_DIR=./data/uploads
# Serve the built web client from the API server (production / desktop).
# CLIENT_DIST_DIR=../client/dist

# --- Secrets (generate with `npm run setup:env`) -------------------------------
JWT_SECRET=REPLACE_ME_with_at_least_48_random_characters
# 32 random bytes, base64. e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REPLACE_ME
# Required to use the first-run setup screen in production. Remove after setup.
# SETUP_TOKEN=REPLACE_ME

# --- Authentication -----------------------------------------------------------
ACCESS_TOKEN_TTL_MIN=15
SESSION_MAX_DAYS=7
SESSION_IDLE_HOURS=12
ALLOW_REGISTRATION=false
ADMIN_REQUIRE_MFA=false
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
# COOKIE_SECURE defaults to true in production.

# --- Rate limits ----------------------------------------------------------------
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=20
AI_REQUESTS_PER_HOUR=30
AI_DAILY_TOKEN_LIMIT=300000

# --- AI assistant (Claude) - optional; AI features are disabled when unset ------
# The key stays on the server: it is never sent to browsers, desktop or mobile clients.
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

LOG_LEVEL=info
